
# GEMINI_API_KEY: Required for Gemini AI API calls.
# AI Studio automatically injects this at runtime from user secrets.
# Users configure this via the Secrets panel in the AI Studio UI.
GEMINI_API_KEY=<your-gemini-key>

# APP_URL: The URL where this applet is hosted.
# AI Studio automatically injects this at runtime with the Cloud Run service URL.
# Used for self-referential links, OAuth callbacks, and API endpoints.
APP_URL="MY_APP_URL"

# Supabase Configuration
VITE_SUPABASE_URL=https://<your-project-ref>.supabase.co
VITE_SUPABASE_PUBLISHABLE_KEY=<your-anon-key>

# IPFS Uploads (Pinata)
# Production Security: Set PINATA_JWT in Supabase secrets and use the Edge Function proxy.
# Local Development/Testing: Set VITE_PINATA_JWT to bypass the proxy.
# VITE_PINATA_JWT=<your-limited-pinata-jwt>
VITE_PINATA_UPLOAD_URL="https://api.pinata.cloud/pinning/pinFileToIPFS"
VITE_PINATA_UNPIN_URL="https://api.pinata.cloud/pinning/unpin"
VITE_IPFS_GATEWAY_URL="https://gateway.pinata.cloud/ipfs"


#
#  Appwrite Configuration 
#
VITE_APPWRITE_PROJECT_ID = "6a020d18000560a24406"
VITE_APPWRITE_PROJECT_NAME = "Magical Toys"
VITE_APPWRITE_ENDPOINT = "https://fra.cloud.appwrite.io/v1

VITE_APPWRITE_DATABASE_ID="6a0211e500308540b3f7"
VITE_APPWRITE_TOYS_COLLECTION_ID="products_collection"
VITE_APPWRITE_CATEGORIES_COLLECTION_ID="categories_collection"
VITE_APPWRITE_ORDERS_COLLECTION_ID="orders_collection"

VITE_DATABASE_PROVIDER="appwrite"
